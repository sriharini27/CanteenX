MONGO_URI=mongodb://localhost:27017
DB_NAME=canteen_smt
JWT_SECRET=7fe737589c6fa1eac7be625ac1c70d54a1c550f2f8f515de2b85ac387a0c9c49
FLASK_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Seed demo data automatically when the database is empty
AUTO_SEED=true
# true = in-memory MongoDB emulation (no install needed, data resets on restart). Use false with a real MongoDB.
USE_MOCK_DB=false
# Google sign-in: OAuth 2.0 "Web application" client ID from Google Cloud Console (leave empty to hide Google login)
GOOGLE_CLIENT_ID=
# Download the default dish photos (Wikimedia Commons) into uploads/foods on first start
FETCH_FOOD_IMAGES=true
